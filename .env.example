# Copy to .env and fill in. Never commit .env.

# Groq — speech-to-text (Whisper large-v3). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini — notes, flashcards, exams, chat. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local development. For a real deployment set DEBUG=False and a long random SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional per-user rate limits on AI calls / per-IP limits on login + register
# AI_RATE_LIMIT=60/hour
# AUTH_RATE_LIMIT=20/hour
